{
  "name": "rainfall-studio",
  "version": "0.9.0-preview.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts.mjs",
    "test": "node --test tests.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:package": "npm run desktop:build && electron-forge package",
    "desktop:make": "npm run desktop:build && electron-forge make",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/run-tests.mjs",
    "test:integration": "node scripts/run-tests.mjs",
    "test:contract": "node scripts/run-tests.mjs",
    "test:security": "node scripts/run-tests.mjs",
    "test:e2e": "node scripts/e2e.mjs && node scripts/journey.mjs && node scripts/cover-task-test.mjs",
    "test:packaged": "node scripts/e2e.mjs --packaged && node scripts/journey.mjs --packaged && node scripts/cover-task-test.mjs --packaged",
    "verify:all": "npm test && npm run typecheck && npm run test:integration && npm run test:e2e",
    "test:tme": "npm run desktop:build && node scripts/test-tme.mjs",
    "test:cover-lyrics": "npm run desktop:build && node scripts/test-cover-lyrics.mjs",
    "test:publish-materials": "node scripts/test-publish-material-feedback.mjs && node --test tests/publish-material-feedback-ui.test.mjs",
    "test:qq-preparation": "node scripts/test-tme-ai-broker.mjs && node --test tests/tme-ai-upload-control.test.mjs tests/tme-ai-native-contract.test.mjs"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.3",
    "electron-squirrel-startup": "1.0.1",
    "luxon": "3.7.2",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "1.64.1",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "electron": "44.7.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "undici": "8.12.1",
    "vite": "8.3.4"
  },
  "main": "build/main.cjs",
  "description": "本地音乐创作与发布准备工作台",
  "author": "Rainfall Studio",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "productName": "Rainfall Studio"
}
